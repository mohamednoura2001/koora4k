{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "css/**",
          "js/**",
          "assets/**",
          "data/**",
          "index.html",
          "manifest.webmanifest",
          "sw.js",
          "ads.txt",
          "a3b1c8f9204e4c2da85f98e1d2c3b4a5.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
